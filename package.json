{
  "name": "@popark05/reverse-screen",
  "version": "0.5.0",
  "private": false,
  "description": "Runtime discovery engine for web, mobile and hybrid application screens and flows.",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "fastify": "^5.2.1",
    "mobilewright": "0.0.70",
    "pg": "^8.13.3",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
