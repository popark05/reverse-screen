{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/reverse-screen/discovery-event/v1/schema.json",
  "title": "Discovery Event",
  "type": "object",
  "required": [
    "event_id",
    "session_id",
    "sequence",
    "event_type",
    "occurred_at",
    "platform",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "screen_observed",
        "element_observed",
        "action_candidate",
        "action_executed",
        "transition_observed",
        "assertion_observed",
        "error",
        "session_marker"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "android",
        "ios",
        "hybrid"
      ]
    },
    "screen_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "state_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "transition_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Event-specific metadata. Action-driven transitions (emitted after POST /actions) use transition_kind=navigation|state_change|no_change with source/target screen and state IDs, action_event_id and navigation_verified=true unless no_change; their transition_id is deterministic in (source state, action, target state). Hybrid context attachment, persistence, and detachment transitions use transition_kind=context_attachment|context_persisted|context_detachment and explicitly set navigation_verified=false; lifecycle observations do not establish navigation causality. Native screen_id/state_id are deterministic per application_id (structure / structure+content)."
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "additionalProperties": false
}
